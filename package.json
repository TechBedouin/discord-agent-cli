{
  "name": "@techbedouin/discord-agent-cli",
  "version": "0.1.0",
  "description": "Agent-friendly persistent Discord API v10 background daemon and CLI with Gateway caching, rate-limit scheduling, and loopback IPC",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "README.md",
    "AGENT.md",
    "CLI_USAGE.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechBedouin/discord-agent-cli.git"
  },
  "homepage": "https://github.com/TechBedouin/discord-agent-cli#readme",
  "bugs": {
    "url": "https://github.com/TechBedouin/discord-agent-cli/issues"
  },
  "keywords": [
    "discord",
    "discord-cli",
    "discord-api",
    "daemon",
    "cli",
    "ai-agent",
    "automation",
    "gateway",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "discord-agent-cli": "./dist/cli/index.js",
    "discord-cli": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm run typecheck && npx tsc -p tsconfig.test.json --noEmit && npm test",
    "daemon": "node ./dist/daemon/index.js",
    "cli": "node ./dist/cli/index.js"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
